#!/usr/bin/env python3
"""Hook PreToolUse (Bash): bloqueia git que muda histórico, branch ou working tree.

Lê o JSON do evento no stdin. Saída 2 = bloqueia; 0 = libera. Só stdlib.
Analisa o comando inteiro: -C/-c/--git-dir, && ; | & $( ) crases, sh -c/bash -c e espaços extras.
"""
import json
import os
import re
import shlex
import sys

BLOQUEADOS = {"commit", "push", "merge", "rebase", "switch", "branch", "stash"}
# opções globais do git que consomem o próximo argumento (forma sem "=")
OPCOES_COM_VALOR = {"-C", "-c", "--git-dir", "--work-tree", "--namespace",
                    "--exec-path", "--super-prefix", "--config-env", "--attr-source"}


def motivo_git(args):
    """args = tokens depois de 'git'. Devolve o motivo do bloqueio ou None."""
    i = 0
    while i < len(args) and args[i].startswith("-"):
        i += 2 if args[i] in OPCOES_COM_VALOR else 1
    if i >= len(args):
        return None
    sub, resto = args[i], args[i + 1:]
    if sub in BLOQUEADOS:
        return f"git {sub}"
    if sub == "checkout" and any(a in ("-b", "-B") or a.startswith("--orphan") for a in resto):
        return "git checkout -b"
    if sub == "reset" and "--hard" in resto:
        return "git reset --hard"
    return None


def analisar(cmd, nivel=0):
    if nivel > 5:
        return None
    cmd = cmd.replace("`", ";").replace("$(", ";(")
    try:
        lex = shlex.shlex(cmd, posix=True, punctuation_chars=True)
        lex.whitespace_split = True
        tokens = list(lex)
    except ValueError:
        # aspas desbalanceadas: na dúvida, olha o texto cru
        m = re.search(r"\bgit\b.*\b(commit|push|merge|rebase|switch|branch|stash)\b", cmd)
        return f"git {m.group(1)} (comando não analisável)" if m else None
    for i, tok in enumerate(tokens):
        ant = tokens[i - 1] if i else ""
        if "git" in tok and (re.fullmatch(r"-[a-z]*c", ant) or ant == "eval"):  # sh -c '...', eval '...'
            if (m := analisar(tok, nivel + 1)):
                return m
        if os.path.basename(tok) == "git":
            fim = next((j for j in range(i + 1, len(tokens)) if re.fullmatch(r"[;&|()]+", tokens[j])), len(tokens))
            if (m := motivo_git(tokens[i + 1:fim])):
                return m
    return None


def main():
    try:
        cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "")
    except (ValueError, AttributeError):
        return 0
    if (m := analisar(cmd)):
        print(f"Bloqueado: {m}. Regra do AGENTS.md: sem commit/push/merge/rebase/branch sem pedido explícito.",
              file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
