{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git * commit*)",
      "Bash(git push:*)",
      "Bash(git * push*)",
      "Bash(git merge:*)",
      "Bash(git * merge*)",
      "Bash(git rebase:*)",
      "Bash(git * rebase*)",
      "Bash(git switch:*)",
      "Bash(git * switch*)",
      "Bash(git checkout -b:*)",
      "Bash(git checkout -B:*)",
      "Bash(git branch *)",
      "Bash(git stash:*)",
      "Bash(git * stash*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bloquear-git" }
        ]
      }
    ]
  }
}
