# =============================================================================
# Central Inteligente de Teleagendamento — variáveis de ambiente
#
# Copie para .env e ajuste:   cp .env.example .env
# O .env NUNCA vai para o Git. Em produção, gere segredos novos direto na VM.
# Gerar um segredo:           python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# --- Ambiente -----------------------------------------------------------------
# obrigatório: development | test | production (outro valor impede a inicialização)
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR (logs sem dados pessoais)
LOG_LEVEL=INFO

# --- Banco (PostgreSQL) -------------------------------------------------------
POSTGRES_DB=teleagendamento
POSTGRES_USER=teleagendamento
POSTGRES_PASSWORD=troque-esta-senha
# porta em 127.0.0.1 da sua máquina
POSTGRES_PORT_HOST=5432
# DATABASE_URL é montada no docker-compose.yml a partir das variáveis acima.

# --- API ----------------------------------------------------------------------
# porta em 127.0.0.1 da sua máquina
API_PORT_HOST=8000
# origens do frontend em desenvolvimento
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (Vite no host) --------------------------------------------------
# Destino do proxy /api em desenvolvimento; mantenha a porta de API_PORT_HOST.
# Só o processo Vite lê este valor; não é exposto ao JavaScript do navegador.
WEB_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Autenticação (ADR-003) ---------------------------------------------------
JWT_SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
ACCESS_TOKEN_TTL_MINUTOS=15
REFRESH_TOKEN_TTL_DIAS=7
# true em produção (HTTPS)
COOKIE_SECURE=false
# lax | strict
COOKIE_SAMESITE=lax
# vazio em desenvolvimento
COOKIE_DOMAIN=
CSRF_HEADER_NAME=X-CSRF-Token
# AM-004: falhas de login (por IP ou por CPF/e-mail) e registros por IP aceitos na janela
LOGIN_MAX_TENTATIVAS=5
# janela e duração do bloqueio, em minutos
LOGIN_JANELA_MIN=15
# AM-004: registros aceitos por IP na mesma janela (a recepção cadastra vários pacientes)
REGISTRO_MAX_TENTATIVAS=20
# chave do HMAC do CPF/e-mail guardado em tentativa_login; diferente do JWT_SECRET_KEY
LOGIN_HASH_KEY=troque-por-outro-segredo-longo-e-aleatorio
# ADR-003: segundos em que um refresh recém-substituído ainda vale (duas abas ao mesmo tempo)
REFRESH_TOLERANCIA_S=10
# UC-001: versão vigente do termo de consentimento; aceite de outra versão é recusado
TERMO_VERSAO_ATUAL=1.0

# --- Banco de demonstração ----------------------------------------------------
# true só na VM da demonstração: libera o seed em APP_ENV=production, junto da flag
# --confirmo-banco-de-demonstracao. Nunca em um banco com cadastros reais.
DEMO_SEED_PERMITIDO=false

# --- Indicadores do gestor ----------------------------------------------------
# tempo máximo de cada consulta, em segundos; passou disso, a API responde 503
INDICADORES_TIMEOUT_S=5

# --- Tempo (ADR-008) ----------------------------------------------------------
# o banco grava timestamptz; isto é só para exibição
TIMEZONE_EXIBICAO=America/Recife

# --- E-mail (Worker) ----------------------------------------------------------
# Em desenvolvimento, use o mailpit:  docker compose --profile dev up -d
# e veja os e-mails em http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# true no provedor real
SMTP_STARTTLS=false
SMTP_FROM="Central de Agendamento <nao-responda@exemplo.com>"
# segundos para conectar e para cada operação; um SMTP lento não trava o Worker
SMTP_TIMEOUT_S=10
# endereço oficial da Central, usado no link dos e-mails (AM-008, AM-015)
APP_URL_PUBLICA=http://localhost:8000

# --- Worker (ADR-005, ADR-006) ------------------------------------------------
WORKER_INTERVALO_EXPIRACAO_S=60
WORKER_INTERVALO_OUTBOX_S=10
OUTBOX_MAX_TENTATIVAS=5
# limpeza de tentativa_login e sessao_refresh vencidas (data-protection.md)
WORKER_INTERVALO_RETENCAO_S=3600
# ADR-021: varredura das vagas livres para propor ao primeiro da fila
WORKER_INTERVALO_MATCHING_S=60
# geração das vagas a partir das agendas, VAGAS_HORIZONTE_DIAS dias à frente
WORKER_INTERVALO_VAGAS_S=3600
VAGAS_HORIZONTE_DIAS=30
# envio dos e-mails pendentes, com novas tentativas em 1, 5, 15 e 60 minutos
WORKER_INTERVALO_EMAIL_S=15
# RF-024: lembretes das consultas confirmadas
WORKER_INTERVALO_LEMBRETE_S=3600
# máximo de itens que cada job processa por rodada; o resto fica para a próxima
WORKER_LOTE_MAXIMO=100

# --- Regras de negócio configuráveis -----------------------------------------
# RN-008 / ADR-021: antecedência mínima entre o fim do prazo de resposta e o horário da vaga
PROPOSTA_ANTECEDENCIA_MINIMA_HORAS=24
# ADR-021: se sobrarem menos horas que isto para o paciente confirmar, a vaga não é proposta
PROPOSTA_JANELA_MINIMA_HORAS=12
# ADR-021: true = o Worker propõe vagas automaticamente; false = o atendente propõe
MATCHING_AUTOMATICO=true
# UC-005 (proposta, a validar com o grupo e a UPE): quantas recusas mantêm a posição na fila;
# a recusa seguinte manda a solicitação para o fim da fila
RECUSAS_MANTENDO_POSICAO=1
# RF-024: o lembrete sai para consultas confirmadas que começam nas próximas N horas
LEMBRETE_ANTECEDENCIA_HORAS=24
