# =============================================================================
# Central Inteligente de Teleagendamento — variáveis de ambiente
#
# Copie para .env e ajuste:   cp .env.example .env
# O .env NUNCA vai para o Git. Em produção, gere segredos novos direto na VM.
# Gerar um segredo:           python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# --- Ambiente -----------------------------------------------------------------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR (logs sem dados pessoais)
LOG_LEVEL=INFO

# --- Banco (PostgreSQL) -------------------------------------------------------
POSTGRES_DB=teleagendamento
POSTGRES_USER=teleagendamento
POSTGRES_PASSWORD=troque-esta-senha
# porta em 127.0.0.1 da sua máquina
POSTGRES_PORT_HOST=5432
# DATABASE_URL é montada no docker-compose.yml a partir das variáveis acima.

# --- API ----------------------------------------------------------------------
# porta em 127.0.0.1 da sua máquina
API_PORT_HOST=8000
# origens do frontend em desenvolvimento
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Autenticação (ADR-003) ---------------------------------------------------
JWT_SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
ACCESS_TOKEN_TTL_MINUTOS=15
REFRESH_TOKEN_TTL_DIAS=7
# true em produção (HTTPS)
COOKIE_SECURE=false
# lax | strict
COOKIE_SAMESITE=lax
# vazio em desenvolvimento
COOKIE_DOMAIN=
CSRF_HEADER_NAME=X-CSRF-Token

# --- Tempo (ADR-008) ----------------------------------------------------------
# o banco grava timestamptz; isto é só para exibição
TIMEZONE_EXIBICAO=America/Recife

# --- E-mail (Worker) ----------------------------------------------------------
# Em desenvolvimento, use o mailpit:  docker compose --profile dev up -d
# e veja os e-mails em http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# true no provedor real
SMTP_STARTTLS=false
SMTP_FROM="Central de Agendamento <nao-responda@exemplo.com>"

# --- Worker (ADR-005, ADR-006) ------------------------------------------------
WORKER_INTERVALO_EXPIRACAO_S=60
WORKER_INTERVALO_OUTBOX_S=10
OUTBOX_MAX_TENTATIVAS=5

# --- Regras de negócio configuráveis -----------------------------------------
# RN-008 / ADR-021: antecedência mínima entre o fim do prazo de resposta e o horário da vaga
PROPOSTA_ANTECEDENCIA_MINIMA_HORAS=24
# ADR-021: se sobrarem menos horas que isto para o paciente confirmar, a vaga não é proposta
PROPOSTA_JANELA_MINIMA_HORAS=12
# ADR-021: true = o Worker propõe vagas automaticamente; false = o atendente propõe
MATCHING_AUTOMATICO=true
